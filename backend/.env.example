# --- Base de donnees (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/lelou_solidarity?sslmode=require"

# --- JWT (espace administrateur) ---
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="12h"

# --- Compte administrateur initial (utilise par prisma:seed) ---
ADMIN_EMAIL="admin@lelousolidarity.org"
ADMIN_PASSWORD="change-moi"
ADMIN_NAME="Administrateur LELOU SOLIDARITY"

# --- Cloudinary (photos + PDF des cartes) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (emails transactionnels) ---
RESEND_API_KEY=""
MAIL_FROM="LELOU SOLIDARITY <no-reply@VOTRE_DOMAINE>"

# --- URLs ---
# Domaine du frontend (Vercel) - sert entre autres a construire le lien de
# verification encode dans le QR code de chaque carte : {FRONTEND_URL}/verify/{token}
FRONTEND_URL="https://VOTRE-FRONTEND.vercel.app"
# Origines autorisees en CORS, separees par des virgules (admin + public)
CORS_ORIGINS="http://localhost:3000"

# --- Divers ---
PORT=4000
NODE_ENV="development"
# Nombre de jours avant expiration pour l'envoi du rappel (J-30 par defaut)
CARD_REMINDER_DAYS_BEFORE=30
