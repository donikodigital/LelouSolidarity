generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  PENDING   // formulaire recu, en attente de traitement par l'administrateur
  VALIDATED // carte generee par l'administrateur
}

enum CardStatus {
  NONE           // pas encore de carte generee
  ACTIVE         // carte valide
  EXPIRING_SOON  // rappel J-30 envoye
  EXPIRED        // carte arrivee a expiration
}

model Admin {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Profil du gérant (page « Mon profil »)
  phone               String?
  avatarUrl           String?   // photo de profil (Cloudinary)
  avatarPublicId      String?
  notifyFormRequests  Boolean   @default(true) // e-mail à chaque nouvelle demande de formulaire

  // Sécurité
  lastLoginAt         DateTime? // dernière connexion
  previousLoginAt     DateTime? // connexion précédente (celle d'avant la session en cours)
  sessionsRevokedAt   DateTime? // « se déconnecter partout » : les jetons émis avant sont refusés

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  email     String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  member    Member?

  // Demande de formulaire à l'origine de ce code (s'il en vient) : ses
  // informations préremplissent et verrouillent le formulaire d'adhésion.
  formRequest FormRequest?

  @@index([email])
}

// Demande de formulaire d'adhesion faite par un futur membre depuis la page
// d'accueil (nom, prenom, ville, e-mail, telephone + message type).
// L'administrateur la retrouve dans son espace et lui envoie un lien d'acces.
model FormRequest {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  city      String
  state     String    @default("") // Etat de residence ; vide pour les demandes faites avant l'ajout du champ
  country   String    @default("États-Unis")
  email     String
  phone     String
  message   String
  locale    String    @default("fr") // langue choisie par le demandeur (fr | en) : e-mails

  handled   Boolean   @default(false)
  handledAt DateTime?
  createdAt DateTime  @default(now())

  // Code d'accès envoyé en réponse à cette demande (le lien contient ce code)
  accessCodeId String?     @unique
  accessCode   AccessCode? @relation(fields: [accessCodeId], references: [id], onDelete: SetNull)

  @@index([handled])
  @@index([createdAt])
}

model Member {
  id             String   @id @default(cuid())

  accessCodeId   String      @unique
  accessCode     AccessCode  @relation(fields: [accessCodeId], references: [id])

  // Informations personnelles
  firstName      String
  lastName       String
  birthDate      DateTime
  birthCity      String   @default("") // Ville de naissance ; vide pour les membres inscrits avant l'ajout du champ

  // Origine
  originDistrict String   // Ville d'origine (ex. Lelouma)
  originLocality String   @default("") // Localite d'origine (ex. Korbe, Sagale) ; vide pour les membres inscrits avant l'ajout du champ

  // Poste dans l'association (imprime sur la carte). Code : MEMBER | PRESIDENT | VICE_PRESIDENT | TREASURER | SECRETARY_GENERAL | OTHER
  position       String   @default("MEMBER")
  positionOther  String   @default("") // poste saisi librement quand position = OTHER

  // Residence aux USA
  addressLine    String
  city           String
  state          String
  country        String   @default("États-Unis")
  locale         String   @default("fr") // langue choisie par le membre (fr | en) : e-mails, carte PDF, rappels
  zipCode        String

  // Contact
  phone          String
  email          String

  // Photo (Cloudinary)
  photoUrl       String
  photoPublicId  String?

  // Statut de traitement
  status         MemberStatus @default(PENDING)

  // Carte de membre
  memberCode     String?     @unique   // ex: LS-2026-0001, attribue a la generation de la carte
  cardStatus     CardStatus  @default(NONE)
  cardIssuedAt   DateTime?
  cardExpiresAt  DateTime?
  cardPdfUrl     String?
  verifyToken    String?     @unique

  // Suivi des rappels automatiques
  reminderSentAt      DateTime?
  expiredNotifiedAt   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([cardStatus])
}
